---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: object[];
}
const {
  title,
  description,
  canonical = 'https://www.samuelbio.fr/',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  ogImage = 'https://www.samuelbio.fr/og/home.jpg',
  ogImageAlt = 'Samuel Bio, développeur Angular freelance senior et Lead Tech Front-end, certifié Expert Angular. Nantes et remote.',
  jsonLd = [],
} = Astro.props;
---
<!doctype html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <link rel="canonical" href={canonical}>
  <meta name="author" content="Samuel Bio">
  <meta name="theme-color" content="#fbf7f0">
  <meta name="format-detection" content="telephone=no">
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Samuel Bio">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:secure_url" content={ogImage}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="627">
  <meta property="og:image:alt" content={ogImageAlt}>
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,750;12..96,800&family=Inter:wght@400;500;600;750&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  {jsonLd.map(ld => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
  <style is:global>
    @font-face{font-family:"Inter Fallback";src:local(Arial),local(Helvetica),local("Liberation Sans");ascent-override:90.2%;descent-override:22.5%;line-gap-override:0%;size-adjust:107.1%}
    @font-face{font-family:"Bricolage Fallback";src:local(Arial),local(Helvetica),local("Liberation Sans");ascent-override:98%;descent-override:26%;line-gap-override:0%;size-adjust:101%}
    :root{--color-bg:#fbf7f0;--color-bg-alt:#f4eee3;--color-surface:#fff;--color-ink:#141414;--color-ink-muted:#47443d;--color-border:#e6dfd2;--color-green:#19c26b;--color-green-ink:#0e7a45;--color-green-soft:#dcf6e7;--color-blue:#2d5bff;--color-blue-soft:#e4eaff;--color-yellow:#ffd84d;--color-yellow-soft:#fff4cc;--color-focus:#2d5bff;--font-display:"Bricolage Grotesque","Bricolage Fallback",system-ui,sans-serif;--font-body:"Inter","Inter Fallback",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--font-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;--fs-xs:.8125rem;--fs-sm:.9375rem;--fs-base:1.0625rem;--fs-lg:1.25rem;--fs-xl:clamp(1.375rem,1.1rem + 1vw,1.75rem);--fs-2xl:clamp(1.875rem,1.4rem + 2.2vw,3rem);--fs-3xl:clamp(2.375rem,1.6rem + 3.8vw,4.5rem);--fw-regular:400;--fw-medium:500;--fw-semibold:600;--fw-bold:750;--fw-black:800;--lh-tight:1.04;--lh-snug:1.2;--lh-body:1.6;--tracking-tight:-.035em;--radius-sm:10px;--radius-md:18px;--radius-lg:28px;--radius-xl:40px;--radius-pill:999px;--space-1:.25rem;--space-2:.5rem;--space-3:.75rem;--space-4:1rem;--space-5:1.5rem;--space-6:2rem;--space-7:3rem;--space-8:4rem;--space-9:6rem;--section-gap:clamp(4rem,3rem + 5vw,7.5rem);--container:72rem;--gutter:clamp(1rem,.5rem + 2.5vw,2rem);--shadow-sm:0 1px 2px #1414140f,0 2px 8px #1414140a;--shadow-md:0 2px 4px #1414140a,0 12px 32px -8px #1414141f;--shadow-lg:0 4px 8px #1414140a,0 24px 56px -16px #1414142e;--ease:cubic-bezier(.2,.7,.2,1)}
    *,::before,::after{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%;text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:5.5rem}
    body{background:var(--color-bg);color:var(--color-ink);font-family:var(--font-body);font-size:var(--fs-base);line-height:var(--lh-body);-webkit-font-smoothing:antialiased;text-rendering:optimizelegibility;margin:0}
    h1,h2,h3{font-family:var(--font-display);font-weight:var(--fw-black);line-height:var(--lh-tight);letter-spacing:var(--tracking-tight);text-wrap:balance;margin:0}
    h1{font-size:var(--fs-3xl)}h2{font-size:var(--fs-2xl)}
    h3{font-size:var(--fs-xl);line-height:var(--lh-snug);letter-spacing:-.02em}
    p{text-wrap:pretty;margin:0}ul,ol{margin:0;padding:0}
    img,svg,picture{max-width:100%;display:block}img{height:auto}
    a{color:inherit;text-underline-offset:.2em;text-decoration-thickness:1.5px}
    code,.mono{font-family:var(--font-mono);font-size:.92em;font-weight:500}
    :focus-visible{outline:3px solid var(--color-focus);outline-offset:3px;border-radius:6px}
    ::selection{background:var(--color-yellow);color:var(--color-ink)}
    .visually-hidden{clip:rect(0 0 0 0);white-space:nowrap;border:0;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;position:absolute!important}
    .container{width:100%;max-width:var(--container);padding-inline:var(--gutter);margin-inline:auto}
    .skip-link{left:var(--space-4);z-index:100;background:var(--color-ink);color:#fff;padding:var(--space-3) var(--space-5);border-radius:var(--radius-pill);font-weight:var(--fw-semibold);text-decoration:none;position:absolute;top:-100px}
    .skip-link:focus{top:var(--space-3)}
    .btn{--btn-bg:var(--color-surface);--btn-fg:var(--color-ink);justify-content:center;align-items:center;gap:var(--space-2);border-radius:var(--radius-pill);border:2px solid var(--color-ink);background:var(--btn-bg);min-height:3.25rem;color:var(--btn-fg);font-family:var(--font-body);font-size:var(--fs-base);font-weight:var(--fw-bold);text-align:center;cursor:pointer;transition:transform .2s var(--ease),box-shadow .2s var(--ease),background-color .2s var(--ease);padding:.8rem 1.6rem;line-height:1.2;text-decoration:none;display:inline-flex}
    .btn:hover{box-shadow:0 4px 0 var(--color-ink);transform:translateY(-2px)}
    .btn:active{box-shadow:none;transform:translateY(0)}
    .btn--primary{--btn-bg:var(--color-green)}
    .btn--ghost{--btn-bg:transparent}.btn--ghost:hover{--btn-bg:var(--color-surface)}
    .btn--dark{--btn-bg:var(--color-ink);--btn-fg:#fff}
    .btn--sm{min-height:2.75rem;font-size:var(--fs-sm);padding:.55rem 1.1rem}
    .btn--lg{min-height:3.5rem;font-size:var(--fs-base);padding:.9rem 1.4rem}
    @media (width>=30rem){.btn--lg{min-height:3.75rem;font-size:var(--fs-lg);padding:1rem 2rem}}
    .btn__arrow{flex:none;width:1.1em;height:1.1em}
    .chips{gap:var(--space-2);flex-wrap:wrap;list-style:none;display:flex}
    .chip{font-family:var(--font-mono);font-size:var(--fs-xs);border-radius:var(--radius-pill);background:var(--color-bg);border:1px solid var(--color-border);color:var(--color-ink);white-space:nowrap;padding:.35rem .7rem;font-weight:500;line-height:1.3;display:inline-block}
    .tech{font-family:var(--font-mono);letter-spacing:-.01em;white-space:nowrap;font-size:.9em;font-weight:600}
    .star{pointer-events:none;flex:none}
    .site-header{z-index:50;background:color-mix(in srgb,var(--color-bg) 88%,transparent);-webkit-backdrop-filter:saturate(1.4) blur(10px);backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid transparent;position:sticky;top:env(safe-area-inset-top,0px)}
    .site-header__inner{justify-content:space-between;align-items:center;gap:var(--space-4);min-height:4.5rem;display:flex}
    .brand{align-items:center;gap:var(--space-2);font-family:var(--font-display);font-weight:var(--fw-black);letter-spacing:-.03em;white-space:nowrap;font-size:1.25rem;text-decoration:none;display:inline-flex}
    .brand__mark{background:var(--color-green);border:2px solid var(--color-ink);letter-spacing:-.02em;border-radius:50%;place-items:center;width:2.25rem;height:2.25rem;font-size:.85rem;display:grid}
    .site-nav{display:none}.site-nav ul{gap:var(--space-1);list-style:none;display:flex}
    .site-nav a{border-radius:var(--radius-pill);font-weight:var(--fw-semibold);font-size:var(--fs-sm);padding:.5rem .85rem;text-decoration:none;display:inline-block}
    .site-nav a:hover{background:var(--color-surface)}
    .hide-sm{display:none}
    @media (width>=52rem){.site-nav{display:block}}
    @media (width>=30rem){.hide-sm{display:inline}}
    .section{padding-block:var(--section-gap)}
    .section--flush-top{padding-top:0}
    .section--alt{background:var(--color-bg-alt)}
    .section__head{gap:var(--space-4);max-width:46rem;margin-bottom:var(--space-7);display:grid}
    .section__kicker{align-items:center;gap:var(--space-2);font-family:var(--font-mono);font-size:var(--fs-sm);color:var(--color-green-ink);font-weight:600;display:inline-flex}
    .section__lead{font-size:var(--fs-lg);color:var(--color-ink-muted)}
    .hero{padding-block:var(--space-7) var(--space-8);position:relative;overflow:hidden}
    .hero__grid{gap:var(--space-7);align-items:center;display:grid}
    .hero__content{gap:var(--space-5);justify-items:start;display:grid}
    .hero__eyebrow{font-family:var(--font-mono);font-size:var(--fs-sm);color:var(--color-green-ink);font-weight:600}
    .hero__title{max-width:20ch;font-size:clamp(2.25rem,1.5rem + 3.2vw,3.9rem)}
    .hero__title .hl{background:linear-gradient(transparent 62%,var(--color-yellow) 62%,var(--color-yellow) 92%,transparent 92%);padding-inline:.05em}
    .hero__subtitle{font-size:var(--fs-lg);color:var(--color-ink-muted);max-width:36rem}
    .hero__actions{gap:var(--space-3);margin-top:var(--space-2);flex-wrap:wrap;display:flex}
    .hero__micro{align-items:center;gap:var(--space-2);font-size:var(--fs-sm);color:var(--color-ink-muted);font-weight:var(--fw-medium);display:inline-flex}
    .hero__micro::before{content:"";background:var(--color-green);width:.55rem;height:.55rem;box-shadow:0 0 0 3px var(--color-green-soft);border-radius:50%}
    .hero__visual{justify-self:center;width:min(100%,19rem);position:relative}
    @media (width>=56rem){.hero__visual{width:min(100%,23rem)}}
    .hero__portrait{border-radius:var(--radius-xl);border:2px solid var(--color-ink);box-shadow:var(--shadow-lg);background:var(--color-green);aspect-ratio:4/5;position:relative;overflow:hidden}
    .hero__portrait img{object-fit:cover;width:100%;height:100%}
    .badge{align-items:center;gap:var(--space-2);border-radius:var(--radius-pill);background:var(--color-surface);border:2px solid var(--color-ink);box-shadow:var(--shadow-md);font-weight:var(--fw-bold);font-size:var(--fs-sm);padding:.6rem 1rem .6rem .75rem;line-height:1.2;display:inline-flex}
    .badge__icon{background:var(--color-yellow);border-radius:50%;flex:none;place-items:center;width:1.9rem;height:1.9rem;display:grid}
    .hero__badge{position:absolute;bottom:1.5rem;left:-.75rem}
    .hero__tag{border-radius:var(--radius-pill);background:var(--color-blue);color:#fff;border:2px solid var(--color-ink);font-family:var(--font-mono);font-size:var(--fs-sm);padding:.45rem .85rem;font-weight:600;position:absolute;top:1.5rem;right:-.5rem;transform:rotate(4deg)}
    .hero__star-1{position:absolute;top:-1.25rem;left:-1.25rem}
    .hero__star-2{position:absolute;bottom:-1rem;right:1.5rem}
    @media (width>=30rem){.hero__badge{left:-1.5rem}}
    @media (width>=56rem){.hero{padding-block:var(--space-7) var(--space-8)}.hero__grid{gap:var(--space-8);grid-template-columns:1.35fr 1fr}}
    .stats{gap:var(--space-4);list-style:none;display:grid}
    .stat{gap:var(--space-1);padding:var(--space-5) var(--space-6);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-md);display:grid}
    .stat__value{font-family:var(--font-display);font-weight:var(--fw-black);font-size:var(--fs-2xl);letter-spacing:var(--tracking-tight);line-height:1}
    .stat__label{color:var(--color-ink-muted);font-weight:var(--fw-medium)}
    .stat:first-child{background:var(--color-green-soft)}
    .stat:nth-child(2){background:var(--color-yellow-soft)}
    .stat:nth-child(3){background:var(--color-blue-soft)}
    @media (width>=48rem){.stats{grid-template-columns:repeat(3,1fr)}}
    .clients{padding-block:var(--space-7) 0}
    .clients__inner{gap:var(--space-4);text-align:center;justify-items:center;display:grid}
    .clients__title{font-family:var(--font-mono);font-size:var(--fs-sm);letter-spacing:0;color:var(--color-ink-muted);font-weight:600}
    .clients__list{justify-content:center;gap:var(--space-3) var(--space-7);flex-wrap:wrap;list-style:none;display:flex}
    .clients__item{font-family:var(--font-display);font-weight:var(--fw-black);letter-spacing:-.03em;color:var(--color-ink);opacity:.85;font-size:clamp(1.75rem,1.3rem + 2vw,2.5rem)}
    .cards{gap:var(--space-4);list-style:none;display:grid}
    @media (width>=44rem){.cards--2{grid-template-columns:repeat(2,1fr)}}
    @media (width>=60rem){.cards--3{grid-template-columns:repeat(3,1fr)}}
    .card{gap:var(--space-4);padding:var(--space-6);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-md);border:1px solid var(--color-border);flex-direction:column;display:flex;position:relative}
    .card__text{color:var(--color-ink-muted)}
    .card__icon{border:2px solid var(--color-ink);width:3rem;height:3rem;font-family:var(--font-mono);font-weight:700;font-size:var(--fs-sm);border-radius:50%;place-items:center;display:grid}
    .card__icon--green{background:var(--color-green)}
    .card__icon--blue{background:var(--color-blue);color:#fff}
    .card__icon--yellow{background:var(--color-yellow)}
    .card .chips{margin-top:auto}
    .benefit{gap:var(--space-4);padding:var(--space-6);border-radius:var(--radius-lg);border:2px solid var(--color-ink);background:var(--color-surface);flex-direction:column;display:flex}
    .benefit:first-child{background:var(--color-green-soft)}
    .benefit:nth-child(2){background:var(--color-blue-soft)}
    .benefit:nth-child(3){background:var(--color-yellow-soft)}
    .benefit__num{font-family:var(--font-mono);font-weight:700;font-size:var(--fs-sm)}
    .benefit .chips{margin-top:auto}
    .benefit .chip{background:var(--color-surface)}
    .sectors{gap:var(--space-3);margin-bottom:var(--space-7);flex-wrap:wrap;list-style:none;display:flex}
    .sector{align-items:center;gap:var(--space-2);border-radius:var(--radius-pill);border:2px solid var(--color-ink);background:var(--color-surface);font-weight:var(--fw-bold);padding:.6rem 1.15rem;display:inline-flex}
    .mission{gap:var(--space-5)}
    .mission__head{justify-content:space-between;align-items:flex-start;gap:var(--space-4);display:flex}
    .mission__client{font-size:var(--fs-2xl)}
    .mission__project{margin-top:var(--space-1);font-family:var(--font-mono);font-size:var(--fs-sm);color:var(--color-green-ink);font-weight:600}
    .mission__sector{border-radius:var(--radius-pill);background:var(--color-yellow);font-size:var(--fs-xs);font-weight:var(--fw-bold);flex:none;padding:.3rem .75rem}
    .mission__facts{gap:var(--space-3);margin:0;display:grid}
    .mission__facts div{gap:var(--space-1);padding-top:var(--space-3);border-top:1px dashed var(--color-border);display:grid}
    .mission__facts dt{font-family:var(--font-mono);font-size:var(--fs-xs);text-transform:uppercase;letter-spacing:.06em;color:var(--color-ink-muted);font-weight:700}
    .mission__facts dd{margin:0}
    .stack{gap:var(--space-4);display:grid}
    @media (width>=56rem){.stack{grid-template-columns:repeat(3,1fr)}}
    .stack__col{align-content:start;gap:var(--space-4);padding:var(--space-6);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-sm);display:grid}
    .stack__col h3{align-items:center;gap:var(--space-2);display:flex}
    .stack .chip{font-size:var(--fs-sm)}
    .faq{gap:var(--space-3);max-width:50rem;display:grid}
    .faq__item{border-radius:var(--radius-md);background:var(--color-surface);border:1px solid var(--color-border);box-shadow:var(--shadow-sm)}
    .faq__item summary{justify-content:space-between;align-items:center;gap:var(--space-4);padding:var(--space-5);cursor:pointer;border-radius:var(--radius-md);list-style:none;display:flex}
    .faq__item summary::-webkit-details-marker{display:none}
    .faq__item summary h3{font-size:var(--fs-lg);letter-spacing:-.015em}
    .faq__toggle{background:var(--color-green-soft);border:1.5px solid var(--color-ink);width:2rem;height:2rem;transition:transform .25s var(--ease);border-radius:50%;flex:none;place-items:center;display:grid}
    .faq__item[open] .faq__toggle{background:var(--color-green);transform:rotate(45deg)}
    .faq__answer{padding:0 var(--space-5) var(--space-5);color:var(--color-ink-muted);max-width:44rem}
    .final-cta{gap:var(--space-5);text-align:center;padding:var(--space-8) var(--space-5);border-radius:var(--radius-xl);background:var(--color-ink);color:#fff;justify-items:center;display:grid;position:relative;overflow:hidden}
    .final-cta h2{max-width:20ch}
    .final-cta p{color:#e9e6df;font-size:var(--fs-lg);max-width:34rem}
    .final-cta .btn{border-color:var(--color-green)}
    .final-cta .btn:hover{box-shadow:0 4px 0 var(--color-green)}
    .final-cta__micro{font-size:var(--fs-sm)!important}
    .final-cta__contacts{justify-content:center;gap:var(--space-3) var(--space-5);margin-top:var(--space-2);flex-wrap:wrap;list-style:none;display:flex}
    .final-cta__contacts a{align-items:center;gap:var(--space-2);color:#fff;font-weight:var(--fw-semibold);padding:.35rem .25rem;display:inline-flex}
    .final-cta__star-1{position:absolute;top:2rem;left:8%}
    .final-cta__star-2{position:absolute;bottom:2.5rem;right:8%}
    .icon{flex:none;width:1.25rem;height:1.25rem}
    .site-footer{padding-block:var(--space-7);border-top:1px solid var(--color-border);font-size:var(--fs-sm)}
    .site-footer__inner{gap:var(--space-5);display:grid}
    .site-footer__links{gap:var(--space-2) var(--space-5);flex-wrap:wrap;list-style:none;display:flex}
    .site-footer__links a{align-items:center;gap:var(--space-2);padding-block:.35rem;display:inline-flex}
    .site-footer__meta{color:var(--color-ink-muted)}
    @media (width>=52rem){.site-footer__inner{grid-template-columns:1fr auto;align-items:center}}
    .prose{max-width:46rem;padding-block:var(--space-8) var(--section-gap)}
    .prose h1{font-size:var(--fs-2xl);margin-bottom:var(--space-6)}
    .prose h2{font-size:var(--fs-xl);margin:var(--space-7) 0 var(--space-3)}
    .prose p,.prose ul{margin-bottom:var(--space-4);color:var(--color-ink-muted)}
    .prose ul{padding-left:1.25rem}
    .prose li+li{margin-top:var(--space-2)}
    .prose a{color:var(--color-green-ink);font-weight:var(--fw-semibold)}
    .rdv{padding-block:var(--space-8) var(--section-gap);position:relative;overflow:hidden}
    .rdv__grid{gap:var(--space-7);align-items:center;display:grid}
    .rdv__content{gap:var(--space-5);justify-items:start;display:grid}
    .rdv__content h1{max-width:14ch}
    .rdv__back{font-size:var(--fs-sm);font-weight:var(--fw-semibold)}
    .slot{gap:var(--space-5);padding:var(--space-6);border-radius:var(--radius-xl);background:var(--color-surface);border:2px solid var(--color-ink);box-shadow:var(--shadow-lg);justify-self:center;width:100%;max-width:28rem;display:grid;position:relative}
    .slot__head{align-items:center;gap:var(--space-4);display:flex}
    .slot__avatar{background:var(--color-green);border:2px solid var(--color-ink);width:3.5rem;height:3.5rem;font-family:var(--font-display);font-weight:var(--fw-black);border-radius:50%;flex:none;place-items:center;display:grid}
    .slot__title{font-size:var(--fs-xl)}
    .slot__by{font-size:var(--fs-sm);color:var(--color-ink-muted)}
    .slot__facts{gap:var(--space-2);flex-wrap:wrap;list-style:none;display:flex}
    .slot__fact{align-items:center;gap:var(--space-2);border-radius:var(--radius-pill);font-weight:var(--fw-semibold);font-size:var(--fs-sm);padding:.45rem .85rem;display:inline-flex}
    .slot__fact:first-child{background:var(--color-blue-soft)}
    .slot__fact:nth-child(2){background:var(--color-green-soft)}
    .slot__fact:nth-child(3){background:var(--color-yellow-soft)}
    .slot__agenda{gap:var(--space-3);padding:var(--space-5);border-radius:var(--radius-md);background:var(--color-bg);list-style:none;display:grid}
    .slot__agenda li{gap:var(--space-3);align-items:baseline;display:flex}
    .slot__agenda .mono{color:var(--color-green-ink);flex:none;font-weight:700}
    .slot .btn{width:100%;padding-inline:1rem}
    @media (width>=56rem){.rdv__grid{grid-template-columns:1.2fr 1fr}}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,::before,::after{transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}.btn:hover{transform:none}}
    @media (forced-colors:active){.btn,.card,.badge,.faq__item{border:2px solid canvastext}}
  </style>
</head>
<body>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <slot />
</body>
