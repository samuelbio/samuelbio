---
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-inner">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Certifié Expert Angular (Level 3)
      </div>
      <h1 id="hero-heading" class="hero-title">
        Développeur Angular freelance senior et Lead Tech Front-end
      </h1>
      <p class="hero-subtitle">
        Applications Angular stables, rapides à faire évoluer et simples à maintenir,
        y compris sur une base de code en retard.
      </p>
      <div class="hero-actions">
        <a href="/rdv" class="btn btn-primary hero-cta-primary">
          Réserver un échange de 20 min
        </a>
        <a href="#references" class="btn btn-secondary">
          Voir mes références
        </a>
      </div>
      <p class="hero-mention">
        <span class="mention-icon">🎥</span>
        En visio · 20 min · sans engagement
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 5rem 4rem;
    background: linear-gradient(160deg, #fbf7f0 0%, #f0eade 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 760px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(45, 108, 223, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(45, 108, 223, 0.2);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 50%;
    display: inline-block;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .hero-title {
    margin-bottom: 1.25rem;
    color: var(--color-text);
    max-width: 700px;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #3d3d3d;
    max-width: 620px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .hero-cta-primary {
    font-size: 1rem;
    padding: 0.85rem 1.75rem;
  }

  .hero-mention {
    font-size: 0.875rem;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mention-icon {
    font-size: 1rem;
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: 3rem 2.5rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      text-align: center;
    }
  }
</style>
