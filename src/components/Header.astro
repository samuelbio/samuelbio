---
interface Props {
  currentPage?: 'index' | 'other';
}
const { currentPage = 'index' } = Astro.props;
const prefix = currentPage === 'index' ? '' : './';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="./" class="brand" aria-label="Samuel Bio, retour à l'accueil">
      <span class="brand__mark" aria-hidden="true">SB</span>
      <span>Samuel Bio</span>
    </a>
    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        <li><a href={`${prefix}#expertise`}>Expertise</a></li>
        <li><a href={`${prefix}#secteurs`}>Secteurs</a></li>
        <li><a href={`${prefix}#parcours`}>Parcours</a></li>
        <li><a href={`${prefix}#faq`}>FAQ</a></li>
      </ul>
    </nav>
    <a href="https://calendar.app.google/xJj7bte6fhgnTmTFA" class="btn btn--primary btn--sm" data-rdv="header" target="_blank" rel="noopener">
      <span>Réserver<span class="hide-sm"> un échange de</span> 20&nbsp;min</span>
      <span class="visually-hidden"> (nouvel onglet)</span>
    </a>
  </div>
</header>
