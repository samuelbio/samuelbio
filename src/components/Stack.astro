---
const stack = [
  {
    category: 'Front-end',
    items: ['Angular', 'TypeScript', 'RxJS', 'NgRx', 'Signals', 'Nx', 'Angular Material', 'Tailwind', 'Design System'],
  },
  {
    category: 'Back-end & DevOps',
    items: ['NestJS', 'Node.js', 'API REST', 'Docker', 'CI/CD'],
  },
  {
    category: 'Qualité',
    items: ['SOLID', 'Clean Code', 'TDD', 'Tests unitaires', 'Tests E2E'],
  },
];
---

<section class="stack section section-alt" id="parcours" aria-labelledby="stack-heading">
  <div class="container">
    <h2 id="stack-heading" class="section-title">Stack technique</h2>
    <p class="section-subtitle">Les outils et méthodes que j'utilise au quotidien.</p>
    <div class="stack-grid">
      {stack.map((group) => (
        <div class="stack-group">
          <h3 class="stack-category">{group.category}</h3>
          <ul class="stack-tags">
            {group.items.map((item) => (
              <li class="stack-tag">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }

  .stack-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stack-category {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .stack-tag {
    background-color: var(--color-card);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 500;
    font-family: var(--font-mono);
    transition: border-color 0.15s, color 0.15s;
  }

  .stack-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
